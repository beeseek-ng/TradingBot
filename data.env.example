# ==============================================================================
# ForexBot Environment Configuration Template (data.env.example)
# ==============================================================================
# Copy this file to data.env and fill in your MT5 account credentials:
#   cp data.env.example data.env
# ==============================================================================

# MetaTrader 5 Account & Broker Credentials
MT5_LOGIN=YOUR_MT5_LOGIN_NUMBER
MT5_ACCOUNT=YOUR_MT5_LOGIN_NUMBER
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=

# Bot Execution Mode (LIVE or PAPER)
EXECUTION_MODE=LIVE
BOT_MODE=LIVE

# Account Balance Settings ($)
ACCOUNT_BALANCE=100.0
INITIAL_BALANCE=100.0

# Cloud Web Dashboard & Health Monitoring
PORT=8080
HOST=0.0.0.0
ENABLE_WEB_DASHBOARD=true
